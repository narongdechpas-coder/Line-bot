# ใส่ค่าจริงใน Netlify > Site configuration > Environment variables ห้าม commit ไฟล์ .env
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
# ค่าสุ่มยาวๆ ใช้ hash userId ก่อนเก็บ (ตั้งครั้งเดียว ห้ามเปลี่ยนภายหลัง)
HASH_SALT=
# Group ID ของกลุ่ม LINE แอดมิน (เชิญ OA เข้ากลุ่ม แล้วบอทจะบอกค่าให้)
ADMIN_GROUP_ID=
# ไม่บังคับ
# HISTORY_TURNS=4
# HANDOFF_MINUTES=60
